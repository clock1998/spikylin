@page
@model Spikylin.Pages.Blog.IndexModel
@inject IStringLocalizer<Spikylin.Pages.Blog.IndexModel> Localizer
@{
    ViewData["Title"] = "Blog";
}
<main class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-6 pb-24">
    <section class="hero rounded-box bg-base-200">
        <div class="hero-content w-full justify-between gap-6 px-6 py-10 max-lg:flex-col max-lg:items-start">
            <div class="max-w-2xl">
                <p class="text-primary text-sm font-semibold tracking-[0.2em] uppercase">Spikylin Journal</p>
                <h1 class="text-base-content mt-3 text-4xl font-bold md:text-5xl">@Localizer["Blog"]</h1>
                <p class="text-base-content/70 mt-4 max-w-xl text-base leading-7 md:text-lg">
                    Notes on software engineering, AI experiments, homelabing, or even wood working...
                </p>
            </div>
            <div class="stats bg-base-100 w-full max-w-md shadow-sm max-sm:stats-vertical sm:stats-horizontal">
                <div class="stat">
                    <div class="stat-title">@Localizer["Posts"]</div>
                    <div class="stat-value text-primary">@Model.Posts.Count</div>
                    <div class="stat-desc">Published articles</div>
                </div>
                <div class="stat">
                    <div class="stat-title">Topics</div>
                    <div class="stat-value text-secondary">@Model.Tags.Count</div>
                    <div class="stat-desc">Filter by tag</div>
                </div> 
            </div>
        </div>
    </section>

    <section class="rounded-box border-base-300 bg-base-100 border p-5 shadow-sm">
        <div class="flex flex-col gap-4">
            <div>
                <h2 class="text-base-content text-lg font-semibold">Browse by topic</h2>
                <p class="text-base-content/70 text-sm">Pick a tag to narrow the list without leaving the page.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a asp-page="/Blog/Index" class="btn btn-sm btn-outline">All</a>
                @foreach (var tag in Model.Tags)
                {
                    <button class="btn btn-sm btn-soft"
                            hx-get="Blog?handler=FilterPosts&tag=@tag"
                            hx-target="#posts"
                            hx-swap="outerHTML">
                        &num;@Html.DisplayFor(n => tag)
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="order-2 space-y-4 lg:order-1">
            <partial name="Partials/_PostsPartial" model="Model.Posts" />
        </div>

        <aside class="order-1 lg:sticky lg:top-24 lg:order-2">
            <div class="rounded-box border-base-300 bg-base-100 space-y-4 border p-4 shadow-sm">
                <div>
                    <h2 class="text-base-content text-xl font-semibold">@Localizer["Featured"]</h2>
                    <p class="text-base-content/70 text-sm">A few highlighted posts to start with.</p>
                </div>
                <partial name="Partials/_FeaturedPostsPartial" model="Model.Posts.Where(n => n.Markdown.Meta.Featured).OrderByDescending(n => n.Markdown.Meta.Date)" />
            </div>
        </aside>
    </section>
</main>
