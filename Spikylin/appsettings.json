{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Photography": {
    "S3": {
      "Endpoint": "https://s3.spikylin.com",
      "BucketName": "public",
      "Prefix": "photography/",
      "DateHeaders": [
        "x-amz-meta-photo-date",
        "x-amz-meta-date",
        "x-amz-meta-taken-at"
      ]
    }
  },
  "AllowedHosts": "*"
}
